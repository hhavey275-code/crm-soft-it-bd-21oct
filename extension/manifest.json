{
  "manifest_version": 3,
  "name": "DSL & Cards Sync — Meta Ad Accounts",
  "version": "2.0.0",
  "description": "SMIT-style live billing sync: page-world hook captures Meta GraphQL responses for cards, limits, threshold, balance and total spending; remove cards via direct GraphQL mutation; one-click sync to your CRM.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "notifications"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://*.supabase.co/*",
    "https://*.lovable.app/*",
    "https://*.lovable.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSL & Cards Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*",
        "https://www.facebook.com/adsmanager/*",
        "https://adsmanager.facebook.com/*",
        "https://*.lovable.app/*",
        "https://*.lovable.dev/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hook.js"],
      "matches": [
        "https://*.facebook.com/*",
        "https://business.facebook.com/*"
      ]
    }
  ]
}
