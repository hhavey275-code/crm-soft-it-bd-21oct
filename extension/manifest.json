{
  "manifest_version": 3,
  "name": "DSL Sync — Ad Account Daily Spending Limit",
  "version": "1.1.0",
  "description": "Sync Daily Spending Limit (DSL) from your Facebook Ads Manager admin account into your dashboard.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms", "notifications"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://*.supabase.co/*",
    "https://*.lovable.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync DSL"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*",
        "https://www.facebook.com/adsmanager/*",
        "https://adsmanager.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}