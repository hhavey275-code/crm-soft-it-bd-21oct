{
  "manifest_version": 3,
  "name": "CRM Top-Up Helper",
  "version": "1.3.5",
  "description": "Semi-automatic external CRM ad account top-up plus WhatsApp client notifications. Auto-pilot processes new top-up requests and queued WhatsApp messages as soon as they arrive.",
  "permissions": ["storage", "activeTab", "notifications", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CRM Top-Up Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
